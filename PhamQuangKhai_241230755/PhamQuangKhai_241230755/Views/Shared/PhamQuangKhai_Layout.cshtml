<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BookHub - Nhà sách trực tuyến</title>
    <link href="~/css/layout.css" rel="stylesheet" type="text/css" />
    <link href="~/css/style.css" rel="stylesheet" type="text/css" />
</head>

<body>
    <partial name="PhamQuangKhai_Header" />

     @RenderBody()

    <partial name="PhamQuangKhai_Footer" />

    <div class="to-top">&uarr;</div>
    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/main.js"></script>
    <script>
        $(function () {
            $('.menu').on('click', '.theloai-link', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                if ($('#noidung').length === 0) {
                    window.location.href = '@Url.Action("Index", "Home")';
                    return;
                }
                $('.menu li').removeClass('active');
                $(this).parent().addClass('active');
                $('#noidung').load('@Url.Action("TheoTheLoai", "Home")?id=' + id);
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>