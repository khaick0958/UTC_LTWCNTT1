@model IEnumerable<BaiThucHanh2.Models.MenuItem>
<nav class="sb-sidenav accordion sb-sidenav-dark" id="sidenavAccordion">
    <div class="sb-sidenav-menu">
        <div class="nav">
            <div class="sb-sidenav-menu-heading">Core</div>
            <a class="nav-link" asp-controller="Home" asp-action="Index"><span class="menu-icon">▦</span> Dashboard</a>
            <div class="sb-sidenav-menu-heading">Addons</div>
            @foreach (var item in Model)
            {
                <a class="nav-link" href="@item.Link"><span class="menu-icon">▣</span> @item.Name</a>
            }
        </div>
    </div>
    <div class="sb-sidenav-footer"><div class="small">Logged in as:</div> Administrator</div>
</nav>
