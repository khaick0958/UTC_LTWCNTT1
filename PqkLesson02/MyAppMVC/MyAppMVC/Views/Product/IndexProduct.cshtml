@{
	ViewData["Title"] = "Trang chủ";
}

<head>
	<link rel="stylesheet" href="~/css/product.css" asp-append-version="true" />
</head>

<body>
	<div class="ProductWrapper">
		<div class="ProductContainer">
			<div class="ProductTitle">
				<h3>Quản lý sản phẩm</h3>
			</div>

			<div class="ProductListContainer">
				<div class="ProductAttributes">
					<div class="AttributesInfo">ID</div>
					<div class="AttributesInfo">Name</div>
					<div class="AttributesInfo">Price</div>
					<div class="AttributesInfo">Created At</div>
					<div class="AttributesInfo">Image</div>
					<div class="AttributesInfo">Actions</div>
				</div>

				<div class="ProductList">
					<div class="ProductInfo">
						<div>1</div>
						<div>Product 1</div>
						<div>500,000 đ</div>
						<div>25-12-2020</div>
						<img src="~/img/Bag1.jpg" />
						<button>View</button>
					</div>

					<div class="ProductInfo">
						<div>2</div>
						<div>Product 2</div>
						<div>750,000 đ</div>
						<div>25-12-2020</div>
						<img src="~/img/Bag1.jpg" />
						<button>View</button>
					</div>

					<div class="ProductInfo">
						<div>3</div>
						<div>Product 3</div>
						<div>550,000 đ</div>
						<div>25-12-2020</div>
						<img src="~/img/Bag1.jpg" />
						<button>View</button>
					</div>

					<div class="ProductInfo">
						<div>4</div>
						<div>Product 4</div>
						<div>550,000 đ</div>
						<div>25-12-2020</div>
						<img src="~/img/Bag1.jpg" />
						<button>View</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</body>
